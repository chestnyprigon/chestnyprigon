<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chestnyprigon.russia-price-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/koredigital/Developer/chestny-prigon/scripts/pricing/run-russia-price-snapshot-loop.zsh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/koredigital/Developer/chestny-prigon</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RUSSIA_PRICE_ENV_FILE</key>
    <string>/Users/koredigital/.config/chestny-prigon/russia-price-refresh.env</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/koredigital/Library/Logs/chestny-prigon/russia-price-refresh.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/koredigital/Library/Logs/chestny-prigon/russia-price-refresh.launchd.err.log</string>
</dict>
</plist>
