[Unit]
Description=Chestny Prigon Yandex Metrica report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/chestny-prigon
EnvironmentFile=/etc/chestny-prigon/metrika.env
EnvironmentFile=/etc/chestny-prigon/pricing-rate-refresh.env
ExecStart=/usr/bin/npm run analytics:metrika
TimeoutStartSec=300
Nice=10
NoNewPrivileges=true
PrivateTmp=true
